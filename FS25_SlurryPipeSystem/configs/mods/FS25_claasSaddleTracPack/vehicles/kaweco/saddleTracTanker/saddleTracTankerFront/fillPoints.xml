<?xml version="1.0" encoding="utf-8"?>
<!-- Kaweco Saddle Trac Tanker Front -->

<!-- FS25_SlurryPipeSystem — Vehicle fillPoints.xml -->
<!-- Author: Oscar Mods -->
<!-- Version: 1.0.0.1 — injected plain hose for normal-tractor pairing -->

<slurryPipeSystem>

    <nodeTree filename="nodeTree.i3d"/>

    <flow fillLitersPerSecond="650" emptyLitersPerSecond="650"/>
	
	<pump pumpType="HVP"/>        <!-- profi2, Samson -->
	
	<!-- Front-mount pass-through: this unit never stores liquid (capacity-0 own
         unit); the tank side of every session is the vehicle its Giants
         connection hoses are attached to. hoseSpecTypes = the hose specType
         values that form the slurry circuit (from the vehicle XMLs). -->
    <frontMount enabled="true" hoseSpecTypes="saddleTracSlurryTanker saddleTracSlurryTankerSemi" hoseTypes="TOOL_CONNECTOR_TOP_RIGHT">
        <!-- Injected PLAIN-type hose for NORMAL tractors (no specType). The
             vanilla saddleTracTankerFront.xml hoses are all specType'd, so
             they can only pair on the Xerion; this hose plugs a normal
             tractor's side-carrier front connector instead. On the Xerion it
             is suppressed automatically (the tractor offers a specType'd
             circuit for the attach joint), so the vanilla pairing is
             untouched and no duplicate hose can appear.
             node resolves by NAME from the vehicle i3d ("topRightPipe" — the
             same mount the vanilla hoses hang from). objectChange shows the
             static hydraulicHoses mesh while connected, mirroring the vanilla
             hoses' own objectChange. -->
        <hose node="topRightPipe" type="TOOL_CONNECTOR_TOP_RIGHT" length="2" diameter="0.18" isTwoPointHose="true" inputAttacherJointIndex="1">
            <objectChange node="hydraulicHoses" visibilityActive="true" visibilityInactive="false"/>
        </hose>
    </frontMount>

    <fillArms>

        <fillArm
            id="1"
            tipType="RUBBER_BOOT_PIT"
            tipNodeName="SPS_fillArmTip01"
			centreNodeName="SPS_fillArmTip01"
            fillUnitIndex="1"
        >
            <effects>
                <effectNode effectClass="PipeEffect" effectNode="effect" materialType="pipe"
                            maxBending="0.8" extraDistance="0.1" positionUpdateNodes="pipeEffectSmoke"/>
                <effectNode effectNode="pipeEffectSmoke" materialType="unloadingSmoke"
                            delay="0.1" alignToWorldY="true"/>
            </effects>
        </fillArm>

    </fillArms>

    <pipeCouplings>

        <pipeCoupling
            id="1"
            mountNodeName="SPS_pipeCoupler01"
            valveType="MANUAL"
            maxPipeLength="4.0"
            fillUnitIndex="1"
            valveFromRearControl="false"
			connector="male"
        />

    </pipeCouplings>

    <!-- [SPS 1.0.1.8] Farm-liquid connector, WATER lane only: this tanker can deliver the water it
         carries into a barn's drinking-water coupler (<animalWaterSystem>) through the sprayer-style
         hose. Its nodes (SPS_liquidPipeCoupler01 + Arcs/inNode/outNode, SPS_liquidControlNode) are
         EMPTY transforms in nodeTree.i3d at the "tankerFront_vis1" origin: position them and add the
         sprayerConnector mesh in GIANTS Editor. See SPS_README_05_Animal_Water.md. -->
    <liquidPipeSystem>
        <liquidPipeCouplings>
            <liquidPipeCoupling id="1" mountNodeName="SPS_liquidPipeCoupler01" fillUnitIndex="1" lanes="WATER"
                                maxPipeLength="7.5" connectorAnimation="3"/>
        </liquidPipeCouplings>
        <liquidPumpControls>
            <liquidPumpControl id="1" nodeName="SPS_liquidControlNode" radius="1.5"/>
        </liquidPumpControls>
    </liquidPipeSystem>

</slurryPipeSystem>
