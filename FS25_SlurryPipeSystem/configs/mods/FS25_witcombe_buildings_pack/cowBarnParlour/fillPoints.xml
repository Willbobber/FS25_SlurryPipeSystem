<?xml version="1.0" encoding="utf-8"?>
<!-- Witcombe Cow Barn Parlour -->

<!-- FS25_SlurryPipeSystem — Placeable fillPoints.xml -->
<!-- Author: Oscar Mods -->
<!-- Version: 1.0.0.0 -->

<slurryPipeSystem agitator="true">
 
    <nodeTree filename="nodeTree.i3d"/>
    <!-- [SPS 1.0.1.8] build menu "Ramp: Yes / No" - No removes this nodeTree node (and everything under it) from the placed store (SPSRampConfiguration) -->
    <rampOption node="slurryPitRamp"/>
	
    <fillPlane
        node="0>9|2|0"
        minY="0.399"
        maxY="1.553"
        fillType="LIQUIDMANURE"
        shape="round"
        centreNodeName="slurryPlaneCentre"
        edgeNodeName="slurryPlaneEdge"
    />
 
    <pipeCouplings>
 
        <pipeCoupling
            id="1"
            mountNodeName="SPS_pipeCoupler01"
            flowDirection="BOTH"
            valveType="NONE"
            deployable="false"
            maxPipeLength="4.0"
			connector="male"
			headHeightNodeName="headHeight01"
        />
 
    </pipeCouplings>
 
    <hideNodes>
		<node name="slurryPit_fence"/>
		<node name="slurryPit_alpsRoadFence02"/>
        <node name="slurryPit_props"/>
        <node name="visualFillTower"/>
        <node name="visualGuardRail"/>
    </hideNodes>
 
    <hideCollisions>
        <node name="collision" node="0>18|0|2|1|0"/>
		<node name="collision" node="0>18|0|2|0|5|1"/>
    </hideCollisions>
	
	<crust density="0.8">
		<plant stage="1" i3d="i3d/foliage/grass01.i3d"  weight="4"/>
		<plant stage="2" i3d="i3d/foliage/grass02.i3d"  weight="3"/>
		<plant stage="3" i3d="i3d/foliage/grass03.i3d"  weight="3"/>
		<plant stage="2" i3d="i3d/foliage/barley01.i3d" weight="2"/>
		<plant stage="3" i3d="i3d/foliage/barley02.i3d" weight="2"/>
		<plant stage="3" i3d="i3d/foliage/barley03.i3d" weight="1"/>
		<plant stage="3" i3d="i3d/foliage/barley04.i3d" weight="1"/>
		<plant stage="3" i3d="i3d/foliage/mushroom.i3d" weight="1"/>
		<plant stage="3" i3d="i3d/foliage/nettle.i3d"   weight="1"/>
	</crust>

    <!-- [SPS 1.0.1.8] MILK lane: barn -> tanker (MILK or BUFFALOMILK, 50000 l each). This barn has
         automatic water supply, so there is deliberately NO water coupler. SPS_milkPipeCoupler01
         (+ Arcs, inNode/outNode) sits in nodeTree.i3d as EMPTY transforms at the "storage" origin:
         position it and add the sprayerConnector mesh in GIANTS Editor. See SPS_README_05_Animal_Water.md. -->
    <milkPipeSystem>
        <milkPipeCouplings>
            <milkPipeCoupling id="1" mountNodeName="SPS_milkPipeCoupler01"
                              maxPipeLength="7.5" connectorAnimation="3"/>
        </milkPipeCouplings>
    </milkPipeSystem>

</slurryPipeSystem>
