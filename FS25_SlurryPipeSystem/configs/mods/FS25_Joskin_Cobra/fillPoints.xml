<?xml version="1.0" encoding="utf-8"?>
<!-- FS25 Joskin Cobra -->

<!-- FS25_SlurryPipeSystem — Vehicle fillPoints.xml -->
<!-- Author: Oscar Mods -->
<!-- Version: 1.0.0.0 -->

<slurryPipeSystem>
    <nodeTree filename="nodeTree.i3d"/>

    <flow fillLitersPerSecond="300" emptyLitersPerSecond="900"/>
	
	<spreaderAnimation name="sprayerAnimation1" stopDelay="1.5"/>
	
	<pump pumpType="vacuum"/>     <!-- vacuum/HVP/conduit/openTop -->
	
	<surfaceRef emptyNode="emptyNode" fullNode="fullNode"/>
	
	<!-- Pressure section optional. Omit entirely to use the SPS defaults shown below.
		maxPressure     : ±bar ceiling; HUD reads from -this to +this
		minThreshold    : bar of stored pressure needed before flow can start
		minBuildTime    : seconds to reach max at a FULL tank (fast build)
		maxBuildTime    : seconds to reach max at an EMPTY tank (slow build); scales by fill ratio
		fallTimeWorking : seconds max->0 while fluid is still transferring (slow taper)
		fallTimeEmpty   : seconds max->0 while venting with no transfer (faster)
		purgeTime       : seconds to vent max->0 when flipping direction against stored pressure
		openTop         : true = passive open-top vessel (FRC-style), never holds pressure, no gauge -->
	<pressure
		maxPressure="2.0"
		minThreshold="0.3"
		minBuildTime="10"
		maxBuildTime="30"
		fallTimeWorking="30"
		fallTimeEmpty="60"
		purgeTime="10"
		openTop="false"
	/>
	
    <fillArms>

        <fillArm
            id="1"
            cylinderedConfigIndex="0"
			configType="design4"
            tipType="OPEN_PIT"
            centreNodeName="SPS_fillArmCentre01"
            fillUnitIndex="1"
		>	
			<effects>
                <effectNode effectClass="PipeEffect" effectNode="effect" materialType="pipe"
                            maxBending="0.8" extraDistance="0.1" positionUpdateNodes="pipeEffectSmoke"/>
                <effectNode effectNode="pipeEffectSmoke" materialType="unloadingSmoke"
                            delay="0.1" alignToWorldY="true"/>
            </effects>
		</fillArm>

        <fillArm
            id="2"
            cylinderedConfigIndex="1"
			configType="design4"
            tipType="RUBBER_BOOT"
            tipNodeName="SPS_fillArmTip01"
            fillUnitIndex="1"
        />

    </fillArms>

    <pipeCouplings>

        <pipeCoupling
            id="1"
            mountNodeName="SPS_pipeCoupler01"
            valveType="MANUAL"
            maxPipeLength="4.0"
            fillUnitIndex="1"
            valveFromRearControl="false"
			connector="male"
        />

        <pipeCoupling
            id="2"
            mountNodeName="SPS_pipeCoupler02"
            valveType="MANUAL"
            maxPipeLength="4.0"
            fillUnitIndex="1"
            valveFromRearControl="false"
			connector="male"
        />

    </pipeCouplings>

    <rubberBootPorts/>

    <outsideControls>
		<outsideControl mountNodeName="pumpControl01" pto="true" direction="false"/>
	</outsideControls>
	
	<!-- [SPS 1.0.0.10.4] Blockage tuning. This is a single wide-bore splash plate with
	     no macerator, and it is the machine's only outlet - blocking it stops
	     spreading entirely. Tuned well above the unprotected-bar default so only
	     genuinely foul slurry can plug it. Remove any attribute to inherit. -->
	<blockageNodes baseChance="0.0005" outletCrustMinRaw="0.85"
	               outletChance="0.010" dmBonus="0.25">
        <blockageNode workAreaConfigIndex="0" mountNodeName="SPS_blockageNodeSplashPlate" workAreaNode="workArea01" blockageAnimation="splashPlate"/>
		<blockageNode workAreaConfigIndex="1" mountNodeName="SPS_blockageNodeSplashPlate" workAreaNode="workArea02" blockageAnimation="splashPlate"/>
	</blockageNodes>
	
	<sounds fullThreshold="0.99">
		<vacPumpFilling template="slurry01"/>
		<vacPumpFull    template="slurry02"/>
	</sounds>
	

    <!-- [SPS 1.0.1.8] Farm-liquid connector, WATER lane only: this tanker can deliver the water it
         carries into a barn's drinking-water coupler (<animalWaterSystem>) through the sprayer-style
         hose. Its nodes (SPS_liquidPipeCoupler01 + Arcs/inNode/outNode, SPS_liquidControlNode) are
         EMPTY transforms in nodeTree.i3d at the "Cobra_vis" origin: position them and add the
         sprayerConnector mesh in GIANTS Editor. See SPS_README_05_Animal_Water.md. -->
    <liquidPipeSystem>
        <liquidPipeCouplings>
            <liquidPipeCoupling id="1" mountNodeName="SPS_liquidPipeCoupler01" fillUnitIndex="1" lanes="WATER"
                                maxPipeLength="7.5" connectorAnimation="4"/>
        </liquidPipeCouplings>
        <liquidPumpControls>
            <liquidPumpControl id="1" nodeName="SPS_liquidControlNode" radius="1.5"/>
        </liquidPumpControls>
    </liquidPipeSystem>
	
	<pipeHolders>
        <pipeHolder id="1" nodeName="SPS_pipeHolder01" radius="1.0"/>
        <pipeHolder id="2" nodeName="SPS_pipeHolder02" radius="1.0"/>
    </pipeHolders>
	
    <!-- [SPS 1.0.1.8] Hidden while PHYSICAL pipes are in use (the store-bought pipes ride on this rack
         instead), shown again in the original system. Any node name of the vehicle's own i3d or of
         this nodeTree; every node of that name is hidden. -->
    <physicalModeHide>
        <node name="Embout"/>
    </physicalModeHide>
	
	<!-- <physicalModeHide> You can also set col to false with this section, if a part has a col
		<node name="Embout" collision="true"/>
		<node name="EmboutCol" collision="true"/>
	</physicalModeHide> -->
</slurryPipeSystem>
