<?xml version="1.0" encoding="utf-8"?>
<!-- Base Tank -->

<!-- FS25_SlurryPipeSystem — Placeable fillPoints.xml -->
<!-- Author: Oscar Mods -->
<!-- Version: 1.0.0.0 -->

<!-- crustGrow: how fast THIS store crusts over.
     1.0 = baseline, 720 game hours (30 in-game days) clean -> fully crusted.
     0.5 = a covered tank, half rate.  1.5 = an exposed open lagoon.
     Absolute game hours - the same on every save, whatever daysPerPeriod is set to.
     Clamped 0.1-10.0 on read, so a typo can never make a store uncrustable.
     agitator="true" is unchanged and is still what opts this store into the crust
     model at all - without it, crustGrow does nothing. -->
<slurryPipeSystem agitator="true" crustGrow="1.0">

    <nodeTree filename="nodeTree.i3d"/>
	
    <fillPlane
        node="slurryPit_fillPlane"
        minY="0"
        maxY="0.763"
        fillType="LIQUIDMANURE"
        shape="round"
        centreNodeName="slurryPlaneCentre"
        edgeNodeName="slurryPlaneEdge"
    />
 
    <pipeCouplings>
 
        <pipeCoupling
            id="1"
            mountNodeName="SPS_pipeCoupler01"
            flowDirection="BOTH"
            valveType="NONE"
            deployable="false"
            maxPipeLength="4.0"
			connector="male"
			headHeightNodeName="headHeight01"
        />
 
    </pipeCouplings>
 
    <hideNodes>
		<node name="slurryPit_fence"/>
		<node name="slurryPit_alpsRoadFence02"/>
        <node name="slurryPit_props"/>
        <node name="visualFillTower"/>
        <node name="visualGuardRail"/>
    </hideNodes>
 
    <hideCollisions>
        <node name="collision"/>
		<node name="collisionFillTower"/>
    </hideCollisions>
	
	<crust density="3.0" planeNode="crust_fillPlane" maxRise="0.16" foliageNode="crustFoliage" edgeMargin="0.1">
		<plant stage="1" i3d="i3d/foliage/grass01.i3d"  weight="6"/>
		<plant stage="2" i3d="i3d/foliage/grass02.i3d"  weight="5"/>
		<plant stage="3" i3d="i3d/foliage/grass03.i3d"  weight="5"/>
		<plant stage="2" i3d="i3d/foliage/barley01.i3d" weight="4"/>
		<plant stage="3" i3d="i3d/foliage/barley02.i3d" weight="4"/>
		<plant stage="3" i3d="i3d/foliage/barley03.i3d" weight="3"/>
		<plant stage="3" i3d="i3d/foliage/barley04.i3d" weight="3"/>
		<plant stage="3" i3d="i3d/foliage/mushroom.i3d" weight="3"/>
		<plant stage="3" i3d="i3d/foliage/nettle.i3d"   weight="3"/>
	</crust>

</slurryPipeSystem>