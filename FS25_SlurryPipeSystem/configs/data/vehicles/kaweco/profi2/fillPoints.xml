<?xml version="1.0" encoding="utf-8"?>
<!-- Kaweco Profi2 -->

<!-- FS25_SlurryPipeSystem — Vehicle fillPoints.xml -->
<!-- Author: Oscar Mods -->
<!-- Version: 1.0.0.6 -->

<slurryPipeSystem>

    <nodeTree filename="nodeTree.i3d"/>

    <flow fillLitersPerSecond="1000" emptyLitersPerSecond="1000"/>

    <pump pumpType="HVP"/>        <!-- profi2, Samson -->

    <surfaceRef emptyNode="emptyNode" fullNode="fullNode"/>

    <fillArms>

        <fillArm
            id="1"
            tipType="OPEN_PIT"
            centreNodeName="SPS_fillArmCentre01"
            fillUnitIndex="1"
        >
            <effects>
                <effectNode effectClass="PipeEffect" effectNode="effect" materialType="pipe"
                            maxBending="0.8" extraDistance="0.1" positionUpdateNodes="pipeEffectSmoke"/>
                <effectNode effectNode="pipeEffectSmoke" materialType="unloadingSmoke"
                            delay="0.1" alignToWorldY="true"/>
            </effects>
        </fillArm>

    </fillArms>

    <pipeCouplings>

        <pipeCoupling
            id="1"
            mountNodeName="SPS_pipeCoupler01"
            valveType="MANUAL"
            maxPipeLength="4.0"
            fillUnitIndex="1"
            valveFromRearControl="false"
            connector="male"
        />

    </pipeCouplings>

    <rubberBootPorts/>

    <pipeHolders>
        <pipeHolder id="1" nodeName="SPS_pipeHolder01" radius="1.0"/>
        <pipeHolder id="2" nodeName="SPS_pipeHolder02" radius="1.0"/>
        <pipeHolder id="3" nodeName="SPS_pipeHolder03" radius="1.0"/>
    </pipeHolders>

    <dockingStationHolders>
        <dockingStationHolder id="1" nodeName="dockingStationPosition" radius="1.5"/>
    </dockingStationHolders>

    <outsideControls>
        <outsideControl mountNodeName="pumpControl01" pto="true" direction="false"/>
    </outsideControls>

    <tractorMountFillArms accepted="true">
        <hose inputAttacherJointIndices="1" type="TOOL_CONNECTOR_TOP_RIGHT" node="slurryPipe" length="2" diameter="0.18" isTwoPointHose="true">
            <objectChange node="coupler" visibilityActive="true" visibilityInactive="false" initialState="inactive"/>
        </hose>
    </tractorMountFillArms>

    <liquidPipeSystem>
        <liquidPipeCouplings>
            <liquidPipeCoupling id="1" mountNodeName="SPS_liquidPipeCoupler01" fillUnitIndex="1" lanes="WATER"
                                maxPipeLength="7.5" valveAnimation="4"/>
        </liquidPipeCouplings>
        <liquidPumpControls>
            <liquidPumpControl id="1" nodeName="SPS_liquidControlNode" radius="1.5"/>
        </liquidPumpControls>
    </liquidPipeSystem>

</slurryPipeSystem>
