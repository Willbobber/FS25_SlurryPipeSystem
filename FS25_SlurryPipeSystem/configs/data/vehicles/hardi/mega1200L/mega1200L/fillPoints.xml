<?xml version="1.0" encoding="utf-8"?>
<!-- Hardi Mega1200L -->

<!-- FS25_SlurryPipeSystem — Vehicle fillPoints.xml -->
<!-- Author: Oscar Mods -->
<!-- Version: 1.0.0.0 -->

<sprayerPipeSystem>

    <nodeTree filename="nodeTree.i3d"/>

    <flow litersPerSecond="200"/>
	
	<pump selfPowered="true"/>
	
	<washout rinseFillUnitIndex="2" rinseShare="0.03" sumpShare="0.01" tankFlushTime="30" boomFlushTime="30"
        finalFlushTime="10" rinseFillTime="10" boomFlushShare="0.1" drainTime="20" requireField="true" autoUnfold="true"
        nozzlePuddles="true" puddleLength="4" puddleWidth="1.2" puddleOverlap="1.15">
        <sounds>
            <tankFlush  file="$data/sounds/vehicles/surfaces/surWaterLoop_03.ogg"   innerRadius="4" outerRadius="35" fadeIn="0.6" fadeOut="0.8">
                <volume indoor="0.45" outdoor="1.0"/>
                </tankFlush>
                <tankFlush2 file="$data/sounds/vehicles/surfaces/vehWaterSplash_01.ogg" innerRadius="4" outerRadius="30" fadeIn="0.6" fadeOut="0.8">
                    <volume indoor="0.35" outdoor="0.8"/>
                </tankFlush2>
                <tankFlush3 file="$data/sounds/vehicles/shared/rainInVehicle.ogg"       innerRadius="3" outerRadius="25" fadeIn="0.6" fadeOut="0.8">
                    <volume indoor="0.4" outdoor="0.7"/>
                </tankFlush3>
        </sounds>
    </washout>
	
    <sounds>
        <engineLoop
            file="$data/vehicles/agi/utx44/sounds/utx44_loop.gls"
            linkNode="exhaustNode"
            innerRadius="10"
            outerRadius="80"
        />
    </sounds>
	
    <sprayerPipeCouplings>

        <sprayerPipeCoupling
            id="1"
            mountNodeName="SPS_sprayerPipeCoupler01"
			flowDirection="BOTH"
            pipeType="sprayerPipe"
			maxPipeLength="7.5"
            fillUnitIndex="1"
            valveFromRearControl="true"
			connectorAnimation="3"
        />

    </sprayerPipeCouplings>

    <sprayerPumpControls>
        <sprayerPumpControl
            id="1"
            nodeName="sprayerControlNode"
            radius="1.5"
        />

    </sprayerPumpControls>
	
</sprayerPipeSystem>