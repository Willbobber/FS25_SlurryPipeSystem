<?xml version="1.0" encoding="utf-8"?>
<!-- Samson Agro PGII28 Genesis -->

<!-- FS25_SlurryPipeSystem — Vehicle fillPoints.xml -->
<!-- Author: Oscar Mods -->
<!-- Version: 1.0.0.3 — straighteningFactor: straight exit section out of the coupler (tune the value; straight direction = slurryPipe local -Z) -->

<slurryPipeSystem>
    <nodeTree filename="nodeTree.i3d"/>

    <flow fillLitersPerSecond="1390" emptyLitersPerSecond="1390"/>
	
	<pump pumpType="HVP"/>        <!-- profi2, Samson -->
	
    <fillArms>

        <fillArm
            id="1"
            cylinderedConfigIndex="0"
            tipType="OPEN_PIT"
            centreNodeName="SPS_fillArmCentre02"
            fillUnitIndex="1"
        >
            <effects>
                <effectNode effectClass="PipeEffect03" effectNode="effect03" materialType="pipe"
                            maxBending="0.8" extraDistance="0.1" positionUpdateNodes="pipeEffectSmoke03"/>
                <effectNode effectNode="pipeEffectSmoke03" materialType="unloadingSmoke"
                            delay="0.1" alignToWorldY="true"/>
            </effects>
        </fillArm>

        <fillArm
            id="2"
            cylinderedConfigIndex="1"
            tipType="RUBBER_BOOT_PIT"
            tipNodeName="SPS_fillArmTip01"
			centreNodeName="SPS_fillArmTip01"
            fillUnitIndex="1"
        >
            <effects>
                <effectNode effectClass="PipeEffect01" effectNode="effect01" materialType="pipe"
                            maxBending="0.8" extraDistance="0.1" positionUpdateNodes="pipeEffectSmoke01"/>
                <effectNode effectNode="pipeEffectSmoke01" materialType="unloadingSmoke"
                            delay="0.1" alignToWorldY="true"/>
            </effects>
        </fillArm>

        <fillArm
            id="3"
            cylinderedConfigIndex="2"
            tipType="OPEN_PIT"
            centreNodeName="SPS_fillArmCentre01"
            fillUnitIndex="1"
        >
            <effects>
                <effectNode effectClass="PipeEffect02" effectNode="effect02" materialType="pipe"
                            maxBending="0.8" extraDistance="0.1" positionUpdateNodes="pipeEffectSmoke02"/>
                <effectNode effectNode="pipeEffectSmoke02" materialType="unloadingSmoke"
                            delay="0.1" alignToWorldY="true"/>
            </effects>
        </fillArm>

    </fillArms>

    <pipeCouplings>

        <pipeCoupling
            id="1"
            cylinderedConfigIndex="1"
            mountNodeName="SPS_pipeCoupler01"
            valveType="MANUAL"
            maxPipeLength="4.0"
            fillUnitIndex="1"
            valveFromRearControl="false"
			connector="male"
        />

        <pipeCoupling
            id="2"
            cylinderedConfigIndex="1"
            mountNodeName="SPS_pipeCoupler02"
            valveType="MANUAL"
            maxPipeLength="4.0"
            fillUnitIndex="1"
            valveFromRearControl="false"
			connector="male"
        />

        <pipeCoupling
            id="3"
            cylinderedConfigIndex="2"
            mountNodeName="SPS_pipeCoupler01"
            valveType="MANUAL"
            maxPipeLength="4.0"
            fillUnitIndex="1"
            valveFromRearControl="false"
			connector="male"
        />

        <pipeCoupling
            id="4"
            cylinderedConfigIndex="2"
            mountNodeName="SPS_pipeCoupler02"
            valveType="MANUAL"
            maxPipeLength="4.0"
            fillUnitIndex="1"
            valveFromRearControl="false"
			connector="male"
        />

    </pipeCouplings>

    <rubberBootPorts>

        <rubberBootPort
            id="1"
            lowerNodeName="SPS_rubberBootLower01"
            upperNodeName="SPS_rubberBootUpper01"
            valveType="NONE"
            fillUnitIndex="1"
        />

    </rubberBootPorts>

    <outsideControls>
		<outsideControl mountNodeName="pumpControl01" pto="true" direction="false"/>
	</outsideControls>
	
	<!-- RECEIVER side of the tractor-mounted front fill arm system.
	     Config-gated (cylinderedConfigIndex, comma-separated 0-based indices,
	     same convention as fillArm/pipeCoupling above):
	       * staticPipe — the fixed pipe mesh for the active config is shown,
	         the other hidden, once at registration. Config 0 = PT arm pipe,
	         configs 1,2 = SAP2 turret pipe.
	       * hose — the injected plain TOOL_CONNECTOR_TOP_RIGHT hose. Every
	         SPS receiver uses the standard mount node name slurryPipe (under
	         the coupler), so one ungated entry serves all configs.
	     objectChange: the coupler shape is hidden until the hose connects
	     (initialState="inactive" hides it at load; the hose and its mount sit
	     under the coupler, so they appear together on connect). -->
	<tractorMountFillArms accepted="true">
		<staticPipe node="samsonFillPipe_PT"   cylinderedConfigIndex="0"/>
		<staticPipe node="samsonFillPipe_Sap2" cylinderedConfigIndex="1,2"/>
		<hose node="slurryPipe" type="TOOL_CONNECTOR_TOP_RIGHT" length="2" diameter="0.18" isTwoPointHose="true" inputAttacherJointIndices="1">
			<objectChange node="coupler" visibilityActive="true" visibilityInactive="false" initialState="inactive"/>
		</hose>
	</tractorMountFillArms>
	
</slurryPipeSystem>