<?xml version="1.0" encoding="utf-8"?>
<!-- Kotte PQ32000 -->

<!-- FS25_SlurryPipeSystem — Vehicle fillPoints.xml -->
<!-- Author: Oscar Mods -->
<!-- Version: 1.0.0.0 -->

<slurryPipeSystem>

    <nodeTree filename="nodeTree.i3d"/>

    <flow fillLitersPerSecond="1600" emptyLitersPerSecond="1600"/>
	
	<pump pumpType="HVP"/>        <!-- profi2, Samson -->
	
	<surfaceRef emptyNode="emptyNode" fullNode="fullNode"/>
	
	<!-- Pressure section optional. Omit entirely to use the SPS defaults shown below.
		maxPressure     : ±bar ceiling; HUD reads from -this to +this
		minThreshold    : bar of stored pressure needed before flow can start
		minBuildTime    : seconds to reach max at a FULL tank (fast build)
		maxBuildTime    : seconds to reach max at an EMPTY tank (slow build); scales by fill ratio
		fallTimeWorking : seconds max->0 while fluid is still transferring (slow taper)
		fallTimeEmpty   : seconds max->0 while venting with no transfer (faster)
		purgeTime       : seconds to vent max->0 when flipping direction against stored pressure
		openTop         : true = passive open-top vessel (FRC-style), never holds pressure, no gauge -->
	<pressure
		maxPressure="2.0"
		minThreshold="0.3"
		minBuildTime="10"
		maxBuildTime="30"
		fallTimeWorking="30"
		fallTimeEmpty="60"
		purgeTime="10"
		openTop="false"
	/>
	
    <fillArms>

        <fillArm
            id="1"
            cylinderedConfigIndex="1"
            tipType="RUBBER_BOOT"
            tipNodeName="SPS_fillArmTip01"
            fillUnitIndex="1"
        />

    </fillArms>

    <pipeCouplings>

        <pipeCoupling
            id="1"
            mountNodeName="SPS_pipeCoupler01"
            valveType="MANUAL"
            maxPipeLength="4.0"
            fillUnitIndex="1"
            valveFromRearControl="false"
			connector="male"
        />

    </pipeCouplings>

    <rubberBootPorts/>

    <outsideControls>
		<outsideControl mountNodeName="pumpControl01" pto="true" direction="false"/>
	</outsideControls>
	
	<!-- RECEIVER side of the tractor-mounted front fill arm system.
         accepted="true": this tanker can be hose-paired with a front mount
         through the tractor's side pipe carrier. The hose below is INJECTED
         into the vehicle's connection hoses by SPS at registration:
           * node        — resolved by name in the SPS nodeTree (slurryPipe is
                           the receiving pipe modelled in this tanker's tree)
           * type        — plain TOOL_CONNECTOR_TOP_RIGHT, no specType: plugs
                           a normal tractor's carrier back-connector and pairs
                           with the front mount's plain hose (same type)
           * inputAttacherJointIndices — the tanker's own input joint (1 = its
                           drawbar/first joint)
         objectChange hides the static hose mesh while the dynamic hose runs. -->
    <tractorMountFillArms accepted="true">
        <hose inputAttacherJointIndices="1" type="TOOL_CONNECTOR_TOP_RIGHT" node="slurryPipe" length="2" diameter="0.18" isTwoPointHose="true">
            <objectChange node="coupler" visibilityActive="true" visibilityInactive="false" initialState="inactive"/>
        </hose>
    </tractorMountFillArms>
	

    <!-- [SPS 1.0.1.8] Farm-liquid connector, WATER lane only: this tanker can deliver the water it
         carries into a barn's drinking-water coupler (<animalWaterSystem>) through the sprayer-style
         hose. Its nodes (SPS_liquidPipeCoupler01 + Arcs/inNode/outNode, SPS_liquidControlNode) are
         EMPTY transforms in nodeTree.i3d at the "pq32000_vis" origin: position them and add the
         sprayerConnector mesh in GIANTS Editor. See SPS_README_05_Animal_Water.md. -->
    <liquidPipeSystem>
        <liquidPipeCouplings>
            <liquidPipeCoupling id="1" mountNodeName="SPS_liquidPipeCoupler01" fillUnitIndex="1" lanes="WATER"
                                maxPipeLength="7.5" connectorAnimation="3"/>
        </liquidPipeCouplings>
        <liquidPumpControls>
            <liquidPumpControl id="1" nodeName="SPS_liquidControlNode" radius="1.5"/>
        </liquidPumpControls>
    </liquidPipeSystem>

</slurryPipeSystem>
