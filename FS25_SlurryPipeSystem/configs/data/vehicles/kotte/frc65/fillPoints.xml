<?xml version="1.0" encoding="utf-8"?>
<!-- Kotte FRC65 -->

<!-- FS25_SlurryPipeSystem — Vehicle fillPoints.xml -->
<!-- Author: Oscar Mods -->
<!-- Version: 1.0.0.0 -->

<slurryPipeSystem>

    <nodeTree filename="nodeTree.i3d"/>

    <flow fillLitersPerSecond="2000" emptyLitersPerSecond="2000"/>
	
	<pump pumpType="openTop"/>    <!-- FRC65 -->
	
	<surfaceRef emptyNode="emptyNode" fullNode="fullNode"/>
	
    <fillArms/>

    <pipeCouplings>

        <pipeCoupling
            id="1"
            mountNodeName="SPS_pipeCoupler01"
            valveType="MANUAL"
            maxPipeLength="4.0"
            fillUnitIndex="1"
            valveFromRearControl="false"
			connector="male"
        />

        <pipeCoupling
            id="2"
            mountNodeName="SPS_pipeCoupler02"
            valveType="MANUAL"
            maxPipeLength="4.0"
            fillUnitIndex="1"
            valveFromRearControl="false"
			connector="male"
        />

        <pipeCoupling
            id="3"
            mountNodeName="SPS_pipeCoupler03"
            valveType="MANUAL"
            maxPipeLength="4.0"
            fillUnitIndex="1"
            valveFromRearControl="false"
			connector="male"
        />

    </pipeCouplings>

    <rubberBootPorts>

        <rubberBootPort
            id="1"
            lowerNodeName="SPS_rubberBootLower01"
            upperNodeName="SPS_rubberBootUpper01"
            valveType="NONE"
            fillUnitIndex="1"
        />

    </rubberBootPorts>

    <pumpControls/>

    <!-- [SPS 1.0.1.8] Farm-liquid connector, WATER lane only: this tanker can deliver the water it
         carries into a barn's drinking-water coupler (<animalWaterSystem>) through the sprayer-style
         hose. Its nodes (SPS_liquidPipeCoupler01 + Arcs/inNode/outNode, SPS_liquidControlNode) are
         EMPTY transforms in nodeTree.i3d at the "frc65_vis" origin: position them and add the
         sprayerConnector mesh in GIANTS Editor. See SPS_README_05_Animal_Water.md. -->
    <liquidPipeSystem>
        <liquidPipeCouplings>
            <liquidPipeCoupling id="1" mountNodeName="SPS_liquidPipeCoupler01" fillUnitIndex="1" lanes="WATER"
                                maxPipeLength="7.5"/>  <!-- connectorAnimation="3" removed 2026-10-24: no valve mesh on this coupler yet (log warning); add it back with the mesh -->
        </liquidPipeCouplings>
        <liquidPumpControls>
            <liquidPumpControl id="1" nodeName="SPS_liquidControlNode" radius="1.5"/>
        </liquidPumpControls>
    </liquidPipeSystem>

</slurryPipeSystem>
