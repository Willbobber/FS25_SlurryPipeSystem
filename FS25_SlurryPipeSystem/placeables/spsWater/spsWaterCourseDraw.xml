<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- [SPS 1.0.1.8] Build-menu tile only (Landscaping > SPS Water): the brush draws a water course,
     nothing is ever placed. simplePlaceable is a vanilla placeable type (placeableTypes.xml); the
     base i3d is the SPS marker-free fallback and is never loaded in game. -->
<placeable type="simplePlaceable" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_spsWaterCourseDraw</name>
        <functions>
            <function>$l10n_function_spsWaterCourseDraw</function>
        </functions>
        <image>icon_SPS.dds</image>
        <price>0</price>
        <dailyUpkeep>0</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>placeableMisc</category>
        <canBeSold>false</canBeSold>
        <showInStore>true</showInStore>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <brush>
            <type>FS25_SlurryPipeSystem.spsWaterDraw</type>
            <category>landscaping</category>
            <tab>spsWater</tab>
        </brush>
    </storeData>

    <!-- store item requirement only; never loaded by the brush -->
    <base>
        <filename>$data/shared/assets/constructionCursorSimple.i3d</filename>
    </base>
</placeable>
