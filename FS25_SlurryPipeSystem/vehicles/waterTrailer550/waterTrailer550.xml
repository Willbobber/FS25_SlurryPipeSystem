    <storeData>
        <name>Water/Chem Bowser</name>
        <functions>
            <function>$l10n_function_tank</function>
        </functions>
        <image>vehicles/waterTrailer550/icon_waterTrailer550.png</image>
        <price>7850</price>
        <lifetime>600</lifetime>
        <rotation>0</rotation>
        <brand>SPS</brand>
        <category>barrels</category>
        <shopTranslationOffset>0 0.212 0</shopTranslationOffset>
        <shopRotationOffset>0.99 0 0</shopRotationOffset>
        <vertexBufferMemoryUsage>699904</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>213760</indexBufferMemoryUsage>
