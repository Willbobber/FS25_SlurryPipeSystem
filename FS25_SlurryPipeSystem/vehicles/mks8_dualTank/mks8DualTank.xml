    <connectionHoses>
        <hose inputAttacherJointIndices="1" type="electric"  node="electric"  length="0.8" diameter="0.016" straighteningFactor="0.5" isTwoPointHose="true" adapterNode="electric_connector">
            <objectChange node="electric_detached" visibilityActive="false" visibilityInactive="true"/>
        </hose>
        <hose inputAttacherJointIndices="1" type="airDoubleRed"  node="hydraulicIn01"  length="0.8" diameter="0.016" straighteningFactor="0.5" isTwoPointHose="true" adapterNode="airRedConnector">
            <objectChange node="hydraulicIn01_detached" visibilityActive="false" visibilityInactive="true"/>
        </hose>
        <hose inputAttacherJointIndices="1" type="airDoubleYellow" node="hydraulicOut01" length="0.7" diameter="0.016" straighteningFactor="0.5" isTwoPointHose="true" adapterNode="airYellowConnector">
            <objectChange node="hydraulicOut01_detached" visibilityActive="false" visibilityInactive="true"/>
        </hose>
        <sounds>
            <connect    type="airDoubleRed" template="hydraulicHosesAttach" volumeScale="0.7" linkNode="attacherJoint"/>
            <connect    type="electric"     template="generalConnection"    volumeScale="0.7" linkNode="attacherJoint"/>
            <disconnect type="airDoubleRed" template="hydraulicHosesDetach" volumeScale="0.7" linkNode="attacherJoint"/>
            <disconnect type="electric"     template="generalConnection"    volumeScale="0.7" linkNode="attacherJoint"/>
        </sounds>
    </connectionHoses>

    <animations>
        <animation name="lockDrawbarLimit">
            <part componentJointIndex="2" startTime="0.0" endTime="0.1" startRotLimit="60 0 0" endRotLimit="0 0 0"/>
        </animation>
        <!-- [SPS MKS8 2026-11-10] the rear door flips up (William: 0 0 0 -> 150 0 0) to reach the SPS fitting; played by
             SPS from the control node (N), must be open before a pipe connects, cannot close with a pipe on -->
        <animation name="rearDoor">
            <part node="rearDoor" startTime="0" endTime="1.2" startRot="0 0 0" endRot="150 0 0"/>
            <sound template="hingeImp" startTime="1.15" direction="1"  volumeScale="0.6" linkNode="rearDoor"/>
            <sound template="hingeImp" startTime="0.05" direction="-1" volumeScale="0.6" linkNode="rearDoor"/>
        </animation>
    </animations>

    <cylindered>
        <movingParts>
            <movingPart node="spring" referencePoint="springRef" referenceFrame="springRef" scaleZ="true" isActiveDirty="true" maxUpdateDistance="60"/>
        </movingParts>
        <sounds>
            <hydraulic template="hydraulicOpen02" linkNode="mks8_main_component1"/>
        </sounds>
    </cylindered>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <!-- [SPS MKS8 2026-11-10] two tanks, half the volume each, every liquid on its own (SPS adds the SPRAYER
                         category to both at registration - extraFillTypes below) -->
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="MILK BUFFALOMILK WATER LIQUIDFERTILIZER HERBICIDE" capacity="4000" allowAILoading="true" showOnHud="true">
                        <exactFillRootNode node="exactFillRootNode" />
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="MILK BUFFALOMILK WATER LIQUIDFERTILIZER HERBICIDE" capacity="4000" allowAILoading="true" showOnHud="true">
                        <exactFillRootNode node="exactFillRootNode02" />
                    </fillUnit>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <fillTriggerVehicle triggerNode="fillTrigger" fillUnitIndex="1" litersPerSecond="350"/>

    <dischargeable>
        <dischargeNode node="dischargeNode" emptySpeed="450" fillUnitIndex="1" canDischargeToGround="false" allowAIDischarge="true">
            <info width="1.0" length="0.5" zOffset="0.4" />
            <trigger node="dischargeTrigger" />
        </dischargeNode>
        <dischargeNode node="dischargeNode02" emptySpeed="450" fillUnitIndex="2" canDischargeToGround="false" allowAIDischarge="true">
            <info width="1.0" length="0.5" zOffset="0.4" />
            <trigger node="dischargeTrigger02" />
        </dischargeNode>
    </dischargeable>

    <waterTrailer fillUnitIndex="1" fillLitersPerSecond="450" fillNode="fillNode">
        <sounds>
            <refill template="defaultRefuelSound" linkNode="0>" />
        </sounds>
    </waterTrailer>

    <!-- [SPS MKS8 2026-11-10] embedded SPS liquid-lane config (read by SPSM_LiquidLanes): ONE fitting behind the rear door
         routing to the SELECTED tank (Shift+Y at the control node picks the tank, Y the direction, R the ball valve = library valveAnimation 4 on the waterHoseConnector01 handle, as the TSA - 2026-11-11), the door
         (loadAnimation, N), an engine with no visual (sounds only - B starts it), two side TUBES holding one short pipe
         each (tube slots: only the start end shows, grab it and walk back; the fitted cap shows while a pipe is in). -->
    <liquidPipeSystem>
        <flow litersPerSecond="200"/>
        <extraFillTypes categories="SPRAYER" fillUnitIndex="1"/>
        <extraFillTypes categories="SPRAYER" fillUnitIndex="2"/>
        <loadAnimation name="rearDoor" doorCloseAuto="false" textOpen="$l10n_sps_mks8DoorOpen" textClose="$l10n_sps_mks8DoorClose"/>
        <liquidPipeCouplings>
            <liquidPipeCoupling id="1" mountNodeName="SPS_liquidPipeCoupler01" maxPipeLength="7.5" fillUnitIndex="1" valveAnimation="4">
                <tank id="1" fillUnitIndex="1" name="$l10n_sps_mks8TankFront" tankTopNodeName="fullNode01" tankBottomNodeName="emptyNode01"/>
                <tank id="2" fillUnitIndex="2" name="$l10n_sps_mks8TankRear"  tankTopNodeName="fullNode02" tankBottomNodeName="emptyNode02"/>
            </liquidPipeCoupling>
        </liquidPipeCouplings>
        <liquidPumpControls>
            <liquidPumpControl id="1" nodeName="SPS_liquidControlNode" radius="1.5"/>
        </liquidPumpControls>
        <generator pulls="2" pullSpeed="1.5" pullPause="0.4">
            <sounds>
                <start      file="$data/sounds/tools/chainsaw/husqvarna/husqvarna_start.ogg" linkNode="SPS_liquidControlNode" volumeScale="1.6" innerRadius="5" outerRadius="50" pitchScale="0.9">
                    <volume indoor="0.6" outdoor="1.0"/>
                </start>
                <engineLoop file="$data/vehicles/agi/utx44/sounds/utx44_loop.gls" linkNode="SPS_liquidControlNode" innerRadius="6" outerRadius="70" volumeScale="1.6">
                    <volume indoor="0.6" outdoor="1.0"/>
                </engineLoop>
            </sounds>
        </generator>
        <pipeHolders>
            <!-- left tube (holder 01 at +X, the vehicle's left) and right tube: each takes the water OR the milk hose -->
            <pipeHolder id="1" nodeName="SPS_pipeHolder01" radius="1.2">
                <placement node="waterPipe" pipes="WATER MILK" tube="true" stowedShow="tubeCapLeftFitted" stowedHide="tubeCapLeftLoose"/>
            </pipeHolder>
            <pipeHolder id="2" nodeName="SPS_pipeHolder02" radius="1.2">
                <placement node="milkPipe"  pipes="WATER MILK" tube="true" stowedShow="tubeCapRightFitted" stowedHide="tubeCapRightLoose"/>
            </pipeHolder>
            <!-- [SPS 2026-11-11] a water cage holder: the cage hangs on SPS_cageHolder01 (its +Z = the cage axis, mount end at the node).
                 cages = the hose keys it takes: CAGE_SMALL (water / milk pipes), CAGE_LARGE (slurry pipes), or both. -->
            <cageHolder id="3" nodeName="SPS_cageHolder01" radius="1.5" cages="CAGE_SMALL" requiresAnimation="rearDoor" requiredAnimationTime="0.95"/>
        </pipeHolders>
    </liquidPipeSystem>

    <foliageBending>
        <bendingNode minX="-1.15" maxX="1.15" minZ="-2.3" maxZ="2.3" yOffset="0.6"/>
        <bendingNode minX="-0.3" maxX="0.3" minZ="-0.5" maxZ="1.6" yOffset="-0.05" node="mks8_drawbar_component3"/>
