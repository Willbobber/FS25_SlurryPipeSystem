             movingParts/arm01/arm02/visuals/hoses2. No nodeTree needed. -->

        <flow fillLitersPerSecond="1000" emptyLitersPerSecond="1000"/>

        <pump pumpType="HVP"/>        <!-- profi2, Samson -->
        <!-- [SPS 1.0.2.0] HVP limits (2026-11-08). A lobe pump PUSHES harder than a vac tank's compressor and SUCKS less
             (self-priming to under 1 bar of vacuum in real life; the mod's scale runs ~3x for the dials, Supercis 3.5 / 2.5):
             + side: the discharge line and the spreading back pressure build to maxPressure over minBuildTime, flow and
             spread rate ramp with it (threshold minThreshold); - side: the fill arm / coupler line pulls to maxVacuum over
             minBuildTimeVacuum (threshold minThresholdVacuum). purgeTime: how fast a line or the spread pressure drains. -->
        <pressure maxPressure="3.0" minThreshold="0.3" minBuildTime="6" maxVacuum="2.0" minThresholdVacuum="0.2" minBuildTimeVacuum="3" purgeTime="4"/>

