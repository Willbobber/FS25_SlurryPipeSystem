        <!-- ===== SPS (1.0.2.0) coupler on the skinned 'coupler' shape (bones under rootJoint > couplerRootBone).
             Everything moves in the coupler's own plane, so every rotation is about the 3rd axis (Z) - except
             the one noted on valve03Bone. time 0 = rest / open, time 1 = clamped / valve open. ===== -->

        <!-- Clamp lever, plays forward when a pipe connects to SPS_pipeCoupler01 (<pipeCoupling
             connectorAnimationName>). clamp01Bone swings the full -90; clamp02Bone and clamp03Bone are solved
             as a four-bar at every key so clamp03RefNode stays ON clamp03RefTargetNode the whole way (the hook
             pivots about that point instead of wandering off it). Keyed every 15 deg of lever: the hook end
             stays within 0.33 mm of the target between keys.
             Lever / link / hook lengths: 0.045363 / 0.124083 / 0.218277 m. -->
        <animation name="couplerClamp">
            <part node="clamp01Bone" startTime="0.0000" endTime="0.1667" startRot="0 0 0"       endRot="0 0 -15"/>
            <part node="clamp01Bone" startTime="0.1667" endTime="0.3333" startRot="0 0 -15"     endRot="0 0 -30"/>
            <part node="clamp01Bone" startTime="0.3333" endTime="0.5000" startRot="0 0 -30"     endRot="0 0 -45"/>
            <part node="clamp01Bone" startTime="0.5000" endTime="0.6667" startRot="0 0 -45"     endRot="0 0 -60"/>
            <part node="clamp01Bone" startTime="0.6667" endTime="0.8333" startRot="0 0 -60"     endRot="0 0 -75"/>
            <part node="clamp01Bone" startTime="0.8333" endTime="1.0000" startRot="0 0 -75"     endRot="0 0 -90"/>

            <part node="clamp02Bone" startTime="0.0000" endTime="0.1667" startRot="0 0 0"       endRot="0 0 9.418"/>
            <part node="clamp02Bone" startTime="0.1667" endTime="0.3333" startRot="0 0 9.418"   endRot="0 0 19.077"/>
            <part node="clamp02Bone" startTime="0.3333" endTime="0.5000" startRot="0 0 19.077"  endRot="0 0 29.323"/>
            <part node="clamp02Bone" startTime="0.5000" endTime="0.6667" startRot="0 0 29.323"  endRot="0 0 40.48"/>
            <part node="clamp02Bone" startTime="0.6667" endTime="0.8333" startRot="0 0 40.48"   endRot="0 0 52.802"/>
            <part node="clamp02Bone" startTime="0.8333" endTime="1.0000" startRot="0 0 52.802"  endRot="0 0 66.423"/>

            <part node="clamp03Bone" startTime="0.0000" endTime="0.1667" startRot="0 0 0"       endRot="0 0 5.917"/>
            <part node="clamp03Bone" startTime="0.1667" endTime="0.3333" startRot="0 0 5.917"   endRot="0 0 11.057"/>
            <part node="clamp03Bone" startTime="0.3333" endTime="0.5000" startRot="0 0 11.057"  endRot="0 0 15.018"/>
            <part node="clamp03Bone" startTime="0.5000" endTime="0.6667" startRot="0 0 15.018"  endRot="0 0 17.431"/>
            <part node="clamp03Bone" startTime="0.6667" endTime="0.8333" startRot="0 0 17.431"  endRot="0 0 18.032"/>
            <part node="clamp03Bone" startTime="0.8333" endTime="1.0000" startRot="0 0 18.032"  endRot="0 0 16.751"/>
        </animation>

        <!-- Valve handle (<pipeCoupling valveAnimationName>). valve01Bone swings the full -45; valve02Bone is
             solved at every key so valve03Bone slides ONLY along its own green (local Y) axis - the shaft line -
             and never off it. That axis is (0.342594 0.939484) in couplerRootBone space, i.e. 20.03 deg off the
             tanker's vertical (the whole coupler is tilted 20 deg), which is why this is NOT a straight lift in
             world Y. Travel along the shaft at -45 = 85.21 mm. Keyed every 7.5 deg of handle: the shaft stays
             within 0.239 mm of its line between keys, exact at every key.
             Crank / link lengths: 0.111725 / 0.161831 m. Rest valve03 at (0.184861 0.37609).

             valve03Bone is the counter-rotation that holds the shaft parallel to itself while the linkage swings
             under it - without it the shaft tips off its line. It is on the 1st axis, NOT the 3rd, and positive:
             valve03Bone sits under the 'valve03' node, whose baked rotation (20.0352 89.5716 0) turns its local
             axes so the coupler plane normal lines up with -X of the bone, not Z. n about its X == -n about the
             plane normal (0.43 deg of axis skew, ~0.08 deg of residual tilt at full open). If the 'valve03' node
             is ever zeroed or the bone re-parented straight onto valve02Bone, move these to "0 0 -n" instead.
             Travel along the shaft per key (mm), to check in GE:
               0: 0.00 | -7.5: 14.78 | -15: 29.85 | -22.5: 44.86 | -30: 59.39 | -37.5: 73.00 | -45: 85.21 -->
        <animation name="couplerValve">
            <part node="valve01Bone" startTime="0.0000" endTime="0.1667" startRot="0 0 0"       endRot="0 0 -7.5"/>
            <part node="valve01Bone" startTime="0.1667" endTime="0.3333" startRot="0 0 -7.5"    endRot="0 0 -15"/>
            <part node="valve01Bone" startTime="0.3333" endTime="0.5000" startRot="0 0 -15"     endRot="0 0 -22.5"/>
            <part node="valve01Bone" startTime="0.5000" endTime="0.6667" startRot="0 0 -22.5"   endRot="0 0 -30"/>
            <part node="valve01Bone" startTime="0.6667" endTime="0.8333" startRot="0 0 -30"     endRot="0 0 -37.5"/>
            <part node="valve01Bone" startTime="0.8333" endTime="1.0000" startRot="0 0 -37.5"   endRot="0 0 -45"/>

            <part node="valve02Bone" startTime="0.0000" endTime="0.1667" startRot="0 0 0"       endRot="0 0 7.734"/>
            <part node="valve02Bone" startTime="0.1667" endTime="0.3333" startRot="0 0 7.734"   endRot="0 0 16.165"/>
            <part node="valve02Bone" startTime="0.3333" endTime="0.5000" startRot="0 0 16.165"  endRot="0 0 25.266"/>
            <part node="valve02Bone" startTime="0.5000" endTime="0.6667" startRot="0 0 25.266"  endRot="0 0 35"/>
            <part node="valve02Bone" startTime="0.6667" endTime="0.8333" startRot="0 0 35"      endRot="0 0 45.317"/>
            <part node="valve02Bone" startTime="0.8333" endTime="1.0000" startRot="0 0 45.317"  endRot="0 0 56.163"/>

            <part node="valve03Bone" startTime="0.0000" endTime="0.1667" startRot="0 0 0"       endRot="0.234 0 0"/>
            <part node="valve03Bone" startTime="0.1667" endTime="0.3333" startRot="0.234 0 0"   endRot="1.165 0 0"/>
            <part node="valve03Bone" startTime="0.3333" endTime="0.5000" startRot="1.165 0 0"   endRot="2.766 0 0"/>
            <part node="valve03Bone" startTime="0.5000" endTime="0.6667" startRot="2.766 0 0"   endRot="5 0 0"/>
            <part node="valve03Bone" startTime="0.6667" endTime="0.8333" startRot="5 0 0"       endRot="7.817 0 0"/>
            <part node="valve03Bone" startTime="0.8333" endTime="1.0000" startRot="7.817 0 0"   endRot="11.163 0 0"/>
        </animation>
    </animations>

