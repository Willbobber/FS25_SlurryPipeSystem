            </liquidPipeCouplings>
            <liquidPumpControls>
                <liquidPumpControl id="1" nodeName="SPS_liquidControlNode" radius="1.5"/>
            </liquidPumpControls>
        </liquidPipeSystem>
		
		<!-- Gauges (2026-11-05). "dial" must match the face PRINTED on that gauge, which is set by the decal
		     material: 1175 = pressure 0..+10, 1176 = vacuum 0..-10 (offsetUV 0.5 0), 1177 = compound -4..+4
		     (offsetUV 0.5 0.5). Printed faces here: tank01-04 vacuum, tank05/07 pressure, tank06/08/09 compound.
		     pumpSide="true" = the PUMP side of that part's valve (what William calls the inner side); without it
		     the gauge reads the line past the valve (the outer side). The three coupler gauges are gated to the
		     same design index 1 as the coupling, so they go with the front fill pipe. -->
		<pressureGauges>
            <!-- fill arm valve: 01 outer side, 02 inner side, 03 reads the same part as 02 but on a compound
                 face. 01 and 02 are VACUUM faces so they only ever show the suction - _gaugePumpSide targets
                 -maxPressure while filling and +maxPressure while discharging, and a 0..-10 dial clamps the
                 positive half away. 03 shows that same reading both ways round. -->
            <pressureGauge type="outer" fillArmId="1" node="pressureGauge_tank01" dial="vacuum"/>
            <pressureGauge type="outer" fillArmId="1" pumpSide="true" node="pressureGauge_tank02" dial="vacuum"/>
            <pressureGauge type="outer" fillArmId="1" pumpSide="true" node="pressureGauge_tank03" dial="compound"/>

            <!-- coupler valve: 04 + 09 inner side, 08 outer side (the pipe connection side). All compound, so
                 they show the coupler both ways round. Not config gated - these belong to the coupler, which is
                 always on the tanker, and have nothing to do with the front fill pipe. -->
            <pressureGauge type="outer" couplingId="1" pumpSide="true" node="pressureGauge_tank04" dial="compound"/>
            <pressureGauge type="outer" couplingId="1" pumpSide="true" node="pressureGauge_tank09" dial="compound"/>
            <pressureGauge type="outer" couplingId="1" node="pressureGauge_tank08" dial="compound"/>

            <!-- discharge line: pressure while the spreader is actually pumping out. HVP: the pump's own pressure,
                 built BECAUSE it pushes slurry out of the spreader (William 2026-11-08) - no stored tank pressure here. -->
            <pressureGauge type="discharge" node="pressureGauge_tank05" dial="pressure"/>
            <pressureGauge type="discharge" node="pressureGauge_tank07" dial="pressure"/>

            <!-- the pump itself: - while filling, + while discharging, across the fill arm, the coupler AND the
                 spreader (while spreading with slurry aboard it builds to the + limit; 2026-11-08, it read 0 there
                 before). Not gated: it still reads the fill arm when the front fill pipe is not fitted. -->
            <pressureGauge type="pump" node="pressureGauge_tank06" dial="compound"/>
        </pressureGauges>
		
    </slurryPipeSystem>

