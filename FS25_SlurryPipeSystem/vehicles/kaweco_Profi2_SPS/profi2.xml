    <!-- Front fill pipe (2026-11-05). Option index 0 = NOT fitted and is the default, so the tanker shows
         without the pipe in the shop; index 1 = fitted.
         ONLY kawecoFillPipe is hidden, and with it its children ('coupler' > 'slurryPipe', the tractor hose
         connector). Nothing else is touched: fillPipeCoupler stays on the tanker either way, and so does every
         pressure gauge - the gauges belong to the coupler, not to this pipe.
         What "Not fitted" removes is the FRONT FILL SYSTEM only: the tractor fill-arm receiver hose (<hose> under
         <tractorMountFillArms>) is gated to index 1 below, so no fill arm can connect to kawecoFillPipe unless the
         pipe is bought. The SPS coupler (couplerRootBone > SPS_pipeCoupler01, the fillPipeCoupler shape) is the
         manual valve for the physical pipe / laid pipe and is NEVER gated or hidden - it is there in both options
         (William 2026-11-07; the 11-05 gate on the coupling was wrong and left a new "Not fitted" tanker with no pipe
         prompt at all). -->
    <designConfigurations title="Front fill pipe">
        <designConfiguration name="Not fitted">
            <objectChange node="kawecoFillPipe" visibilityActive="false"/>
        </designConfiguration>
        <designConfiguration name="Fitted" price="1200">
            <objectChange node="kawecoFillPipe" visibilityActive="true"/>
        </designConfiguration>
    </designConfigurations>

