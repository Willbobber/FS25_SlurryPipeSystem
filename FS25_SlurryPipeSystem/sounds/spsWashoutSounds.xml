<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- FS25_SlurryPipeSystem - default sprayer washout sounds (SPSChemWashout). -->
<!-- A sprayer can override them in its SPS config: <sprayerPipeSystem><washout ...><sounds><tankFlush .../></sounds></washout> -->
<!-- tankFlush, tankFlush2 ... tankFlush5: played TOGETHER while the rinse water is thrown round the main tank -->
<!--     (tank flush + final flush). William 2026-11-07: three layered = water being thrown around inside. -->
<!-- boomFlush: optional, the water going out through the nozzles (boom flush + running the rinse water out); -->
<!--     the sprayer's own spray sound plays then anyway. -->
<sounds>
    <!-- water churning -->
    <tankFlush file="$data/sounds/vehicles/surfaces/surWaterLoop_03.ogg" innerRadius="4" outerRadius="35" fadeIn="0.6" fadeOut="0.8">
        <volume indoor="0.45" outdoor="1.0"/>
    </tankFlush>
    <!-- splashes against the tank walls -->
    <tankFlush2 file="$data/sounds/vehicles/surfaces/vehWaterSplash_01.ogg" innerRadius="4" outerRadius="30" fadeIn="0.6" fadeOut="0.8">
        <volume indoor="0.35" outdoor="0.8"/>
    </tankFlush2>
    <!-- spray drumming inside the tank -->
    <tankFlush3 file="$data/sounds/vehicles/shared/rainInVehicle.ogg" innerRadius="3" outerRadius="25" fadeIn="0.6" fadeOut="0.8">
        <volume indoor="0.4" outdoor="0.7"/>
    </tankFlush3>
</sounds>
